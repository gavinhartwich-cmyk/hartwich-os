# Copy this file to .env.local and fill in real values.
# Full walkthrough for every one of these: SETUP.md

# --- Supabase (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never expose to the client. Only used by
# scripts/create-auth-users.ts to create the two allow-listed accounts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Postgres connection (Settings -> Database -> Connection string) ---
# Use the "Transaction" pooler URI (port 6543) - required for serverless functions.
DATABASE_URL=

# --- Google Cloud (OAuth + Places API) ---
# Google OAuth client id/secret are configured inside Supabase Auth
# (Authentication -> Providers -> Google), not here. GOOGLE_PLACES_API_KEY
# is used directly by the lead-discovery workflow (Phase 2).
GOOGLE_PLACES_API_KEY=

# --- Groq (AI qualification + website enrichment, Phase 2) ---
# Free tier, no billing/credit card required — console.groq.com/keys.
# Used by src/lib/ai/enrich-company.ts and src/lib/ai/qualify-lead.ts.
GROQ_API_KEY=

# --- Anthropic (reserved for Phase 3 outreach drafting — not read by any
# Phase 2 code path; src/lib/ai/claude.ts exists but is unused for now) ---
ANTHROPIC_API_KEY=

# --- Inngest (background workflows, Phase 2+) ---
# Local dev: run `npx inngest-cli@latest dev` alongside `npm run dev` — no
# keys needed. These are only required once deployed (Inngest Cloud).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Slack (optional lead-mining run notifications, Phase 2) ---
# A Slack "Incoming Webhook" URL. Leave blank to skip notifications entirely
# — src/lib/integrations/slack.ts no-ops when this isn't set.
SLACK_WEBHOOK_URL=

# --- Twilio (SMS, Phase 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Apollo (contact enrichment, Phase 5) ---
APOLLO_API_KEY=
