# Copy this file to .env.local and fill in real values.
# Full walkthrough for every one of these: SETUP.md

# --- Supabase (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — server-only, never expose to the client. Only used by
# scripts/create-auth-users.ts to create the two allow-listed accounts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase Postgres connection (Settings -> Database -> Connection string) ---
# Use the "Transaction" pooler URI (port 6543) - required for serverless functions.
DATABASE_URL=

# --- Google Cloud (OAuth + Places API) ---
# Google OAuth client id/secret are configured inside Supabase Auth
# (Authentication -> Providers -> Google), not here. GOOGLE_PLACES_API_KEY
# is used directly by the lead-discovery workflow (Phase 2).
GOOGLE_PLACES_API_KEY=

# --- Groq (website enrichment + outreach drafting, Phase 2/3) ---
# Free tier, no billing/credit card required — console.groq.com/keys.
# Used by src/lib/ai/enrich-company.ts and src/lib/ai/draft-outreach.ts.
# NOT used by qualify-lead.ts — lead qualification is a plain review-count/
# rating rule (commit 1fc1c54), no AI call, no key needed.
GROQ_API_KEY=

# --- Inngest (background workflows, Phase 2+) ---
# Local dev: run `npx inngest-cli@latest dev` alongside `npm run dev` — no
# keys needed. These are only required once deployed (Inngest Cloud).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Slack (optional lead-mining run notifications, Phase 2) ---
# A Slack "Incoming Webhook" URL. Leave blank to skip notifications entirely
# — src/lib/integrations/slack.ts no-ops when this isn't set.
SLACK_WEBHOOK_URL=

# --- Gmail (outreach email sending, Phase 3) ---
# src/lib/integrations/gmail-multi.ts is what's actually wired up (approve-
# and-send/route.ts imports it) — 3 rotating accounts, one client id/secret
# shared across all three, per-account tokens. Rotation reads whichever
# account sent last (email_drafts.sent_from_email_index), so all 3 accounts'
# tokens need to be set or sending fails once rotation reaches an unset one.
# To set up, per Google Cloud project (https://console.cloud.google.com):
# 1. Enable the Gmail API
# 2. Create an OAuth 2.0 credential (Client ID + secret) — shared by all 3
#    accounts below
# 3. For each of the 3 Gmail accounts: run the OAuth2 consent flow as that
#    account (e.g. via Google's OAuth Playground, https://developers.google.com/oauthplayground,
#    using your own client id/secret under its settings gear icon) with the
#    gmail.send scope, to get a refresh token; the SDK (google-auth-library,
#    already handling auto-refresh-on-401) mints access tokens from it, so
#    the initial ACCESS_TOKEN value just needs to be non-empty to pass the
#    startup check — it self-heals via REFRESH_TOKEN once it expires.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_ACCESS_TOKEN_1=
GMAIL_REFRESH_TOKEN_1=
GMAIL_FROM_ADDRESS_1=
GMAIL_ACCESS_TOKEN_2=
GMAIL_REFRESH_TOKEN_2=
GMAIL_FROM_ADDRESS_2=
GMAIL_ACCESS_TOKEN_3=
GMAIL_REFRESH_TOKEN_3=
GMAIL_FROM_ADDRESS_3=

# --- Twilio (SMS) ---
# Optional. Powers the SMS leg of booking reminders (Phase 6) — get an
# account SID + auth token + phone number from console.twilio.com. Booking
# and email reminders work fully without this; it just skips the text.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Apollo (contact enrichment, Phase 5) ---
APOLLO_API_KEY=

# --- Google Calendar (task/meeting sync — Phase 5; required for booking — Phase 6) ---
# Optional for the internal /calendar page and tasks table — those work
# fine without it, they just won't mirror to Google Calendar.
# REQUIRED for the public /book page (Phase 6): availability is computed
# from real free/busy on this calendar, and booked meetings are created
# here — without it, /book shows "booking isn't available" and refuses to
# guess at open slots rather than risk double-booking you.
# Same OAuth dance as Gmail above (console.cloud.google.com), but enable
# the Calendar API instead and request the calendar scope. Single account
# (your own calendar) — no _1/_2/_3 suffixes needed here.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ACCESS_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
